# Settings the binary reads are named with the app prefix; the unprefixed ones
# below are consumed by the Justfile and the docker recipes instead.

# Specify the directory to store the database, TLS certificates, and other state.
# Deliberately unprefixed: read by the CLI layer, not the config layer.
ROOT_DIR=${HOME}/.local/share/${APP}

# The IP address the app itself should listen with:
# (0.0.0.0 means all interfaces are allowed to connect.)
${APP_PREFIX}NET_LISTEN_IP=0.0.0.0
# The TCP port number the app should listen with:
${APP_PREFIX}NET_LISTEN_PORT=3000

## Session settings:
# Default session expiration (in seconds):
${APP_PREFIX}SESSION_EXPIRY_SECONDS=604800
# How often to check for session expiration (in seconds):
${APP_PREFIX}SESSION_CHECK_SECONDS=60
# Force session cookies to be sent over HTTPS. Defaults to true.
# Set false when serving plain HTTP on anything but localhost, or the browser
# discards the cookie and logins will not stick.
${APP_PREFIX}SESSION_SECURE=true

## Proxy Settings (only used if AUTHENTICATION_METHOD=forward_auth or TRUSTED_FORWARDED_FOR=true)
# The domain name that the Traefik Proxy should use to route to this container.
# This host is also used as the TLS certificate Common Name (CN).
APP_HOST=change-me.example.com
# Enter the IP address of the Traefik Proxy peer (on same docker network).
# When Trusted Header Auth or Forwarded For middleware is enabled,
# the incoming IP address of the request must match this value:
${APP_PREFIX}AUTH_TRUSTED_PROXY=127.0.0.1
# The Trusted header name that contains the user identification.
${APP_PREFIX}AUTH_TRUSTED_HEADER_NAME=X-Forwarded-User
# The trusted header authentication group used by Traefik Forward Auth
# (The user email address must be listed in the group to gain access to the server).
AUTH_TRUSTED_HEADER_AUTH_GROUP=admin
# The trusted header that contains the client's forwarded IP address:
${APP_PREFIX}AUTH_TRUSTED_FORWARDED_FOR_NAME=X-Forwarded-For

## Build settings
# The container engine command to invoke: docker or podman
DOCKER=docker
# The cargo release/debug profile to build the binary
CARGO_PROFILE=release
# The name of the Docker image to build
DOCKER_IMAGE=ghcr.io/${GIT_USERNAME}/${APP}:latest
# Set logging level (error,warn,info,debug):
RUST_LOG=debug
# Show extended debugging info on panic:
RUST_BACKTRACE=1
# The name of the git remote for repository auto-detection
GIT_REMOTE=origin

## TLS settings
# TLS mode to use: none, manual, acme, or self-signed.
#   none        -> plain HTTP only.
#   manual      -> use TLS_CERT and TLS_KEY.
#   acme        -> use ACME (Let's Encrypt, Step-CA, etc.).
#   self-signed -> generate a self-signed certificate at startup.
${APP_PREFIX}TLS_MODE=none
# Path to the TLS certificate and key (PEM). Uncomment BOTH only when
# TLS_MODE=manual; setting them in any other mode is rejected at startup.
#${APP_PREFIX}TLS_CERT=cert.pem
#${APP_PREFIX}TLS_KEY=key.pem
# Additional DNS SubjectAltNames (SANs) for the TLS certificate.
# APP_HOST is always used as the primary Common Name (CN).
# Comma-separated list.
${APP_PREFIX}TLS_SANS=
# ACME challenge type to use: tls-alpn-01, http-01, or dns-01.
${APP_PREFIX}TLS_ACME_CHALLENGE=tls-alpn-01
# ACME directory URL. Default is Let's Encrypt production.
${APP_PREFIX}TLS_ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory
# Contact email for ACME registration.
${APP_PREFIX}TLS_ACME_EMAIL=
# Validity in SECONDS for a self-signed certificate (315360000 = 3650 days).
# Uncomment only when TLS_MODE=self-signed.
#${APP_PREFIX}TLS_SELF_SIGNED_VALID_SECONDS=315360000
